# Keep line endings right on every student's machine, whatever their git autocrlf setting.
* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# these run inside a Linux container (Docker lab): CRLF would break them
*.sh text eol=lf
Dockerfile* text eol=lf
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.xacro text eol=lf
*.urdf text eol=lf
*.pdf binary
*.png binary
