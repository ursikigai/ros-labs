<?xml version="1.0"?>
<!-- DiffBot: a small differential-drive robot used by Classes 2-5.
     Evolved from upstream/urdf_tutorial (07-physics, 08-macroed) and the Packt
     "ROS 2 from Scratch" ch12/ch13 my_robot_description. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="diffbot">

  <!-- ===== Parameters (single source of truth for geometry) ===== -->
  <!-- Gap between the ground and the underside of the body. 0.0 is right for the kinematic simulator and RViz.
       A physics engine (Isaac Sim) needs a positive gap, otherwise the body rests on the floor and the wheels carry no weight. -->
  <xacro:arg name="body_clearance" default="0.0"/>
  <xacro:property name="body_clearance" value="$(arg body_clearance)"/>
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.03"/>
  <xacro:property name="wheel_separation" value="0.30"/>
  <xacro:property name="body_length" value="0.30"/>
  <xacro:property name="body_width" value="0.20"/>
  <xacro:property name="body_height" value="0.10"/>
  <xacro:property name="caster_radius" value="0.025"/>

  <!-- ===== Materials ===== -->
  <material name="body_blue"><color rgba="0.1 0.3 0.8 1.0"/></material>
  <material name="wheel_black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="lidar_red"><color rgba="0.8 0.1 0.1 1.0"/></material>
  <material name="caster_grey"><color rgba="0.6 0.6 0.6 1.0"/></material>

  <!-- ===== Macros ===== -->
  <xacro:macro name="wheel" params="side y_sign">
    <link name="${side}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${y_sign * wheel_separation / 2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- ===== Links and joints ===== -->
  <!-- The root link carries a (tiny) mass only when a physics engine will load the model (xacro argument physics:=true):
       a link without mass would get the engine's default of 1 kg and spoil the balance, but ROS's KDL parser warns about
       an inertia on the root link, so the default (RViz, kinematic simulator) has none. -->
  <xacro:arg name="physics" default="false"/>
  <link name="base_footprint">
    <xacro:if value="$(arg physics)">
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
      </inertial>
    </xacro:if>
  </link>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${body_clearance}" rpy="0 0 0"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${body_clearance}" rpy="0 0 0"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </collision>
    <!-- Centre of mass 3 cm behind the wheel axle, so a physics engine rests the robot on its caster instead of tipping it
         onto its nose (the caster is a fixed, frictionless ball). Only physics simulators read this; RViz and the kinematic
         simulator ignore it. -->
    <inertial>
      <origin xyz="-0.03 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <!-- The robot origin (base_link) sits one wheel radius above the ground. -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <xacro:wheel side="left" y_sign="1"/>
  <xacro:wheel side="right" y_sign="-1"/>

  <link name="caster_link">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="caster_grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${-body_length / 2 + 0.04} 0 ${-wheel_radius + caster_radius}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="lidar_red"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.08 0 ${body_height / 2 + 0.02 + body_clearance}" rpy="0 0 0"/>
  </joint>

</robot>
