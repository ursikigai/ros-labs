<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>diffbot_bringup</name>
  <version>0.1.0</version>
  <description>Launch files that assemble the DiffBot course stack (Classes 3-5).</description>
  <maintainer email="ranjeetsingh-air@dsu.edu.in">Course Maintainer</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>diffbot_description</exec_depend>
  <exec_depend>diffbot_sim</exec_depend>
  <exec_depend>diffbot_odometry</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
